{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kinflix",
  "version": "0.1.0",
  "identifier": "com.tekin.kinflix",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "kinflix",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },

  "plugins": {
    "updater": {
      "endpoints": [
        "https://senin-github-adin.github.io/kinflix-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzMURBQzQ1QkUwMDY1RkIKUldUN1pRQytSYXdkTTBrclo5SUVoL3pCUEhmN3hFcndIOVZTRlJMbEF5YVh3NjZqS2dBTzB2NWwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}