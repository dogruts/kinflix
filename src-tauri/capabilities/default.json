{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "sql:default",
    "sql:allow-execute",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.themoviedb.org/**"
        },
        {
          "url": "https://api.opensubtitles.com/**"
        }
      ]
    }
  ]
}